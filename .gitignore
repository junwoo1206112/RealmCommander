sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# TextMeshPro
[Aa]ssets/TextMesh[Pp]ro/

# IDEs
.idea/
*.swp
*~.nib
*.Rhistory

# OS
.DS_Store
Thumbs.db
nul

# OpenSpec
.opencode/

